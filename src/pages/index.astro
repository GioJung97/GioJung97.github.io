---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import Controls from "../components/Controls.astro";
import avatar from "../assets/images/profile_pic.jpg";
import {
  profile, ui, news, publications, preprints, posters, experience, education, honors, skills, type Paper,
} from "../data/site";

const projects = (await getCollection("projects")).sort(
  (a, b) => Number(b.data.pinned) - Number(a.data.pinned) || b.data.order - a.data.order,
);

const sections = [
  { id: "about", label: ui.about },
  { id: "projects", label: ui.projects },
  { id: "research", label: ui.research },
  { id: "experience", label: ui.experience },
];

const fmtDate = (d: string) => d.slice(0, 7).replace("-", ".");
const external = (href: string) => /^https?:/.test(href);
const icons: Record<string, string> = {
  GitHub: '<path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/>',
  LinkedIn: '<path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.33-1.96 2.7V21h-4z"/>',
  Scholar: '<path fill="currentColor" d="M12 3 1 9l11 6 9-4.91V17h2V9zm-6.82 9.4V16c0 1.66 3.06 4 6.82 4s6.82-2.34 6.82-4v-3.6L12 16.1z"/>',
  Email: '<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4zM4 7l8 6 8-6"/>',
  CV: '<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"/>',
};
const paperGroups: { label: typeof ui.publications; items: Paper[] }[] = [
  { label: ui.publications, items: publications },
  { label: ui.preprints, items: preprints },
  { label: ui.posters, items: posters },
];
---
<Base>
  <div class="shell">
    <aside class="aside">
      <div class="id">
        <Image src={avatar} alt={profile.name} width={160} height={160} fit="cover" class="avatar" loading="eager" />
        <div>
          <h1>{profile.name}</h1>
          <div class="tagline"><T t={profile.tagline} /></div>
        </div>
      </div>
      <p class="lede"><T t={profile.oneLiner} /></p>
      <div class="links">
        {profile.links.map((l) => (
          <a href={l.href} target={external(l.href) || l.href.endsWith(".pdf") ? "_blank" : undefined} rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[l.label] ?? ""} />{l.label}
          </a>
        ))}
      </div>
      <div class="now">
        <span class="lbl"><T t={ui.now} /></span>
        {profile.now.map((r) => <div><b><T t={r.role} /></b><span>{r.org}</span></div>)}
      </div>
      <section class="ticker" aria-roledescription="carousel" aria-label="News">
        <div class="ticker-head">
          <span class="lbl"><T t={ui.news} /></span>
          <span class="ticker-nav">
            <button type="button" data-tick="-1" aria-label="Previous news">‹</button>
            <span class="ticker-count" aria-hidden="true"><span data-tick-i>1</span>/{news.length}</span>
            <button type="button" data-tick="1" aria-label="Next news">›</button>
          </span>
        </div>
        <div class="ticker-body" aria-live="polite">
          {news.map((n, i) => (
            <div class="tick" data-tick-item hidden={i !== 0}>
              <time datetime={n.date}>{fmtDate(n.date)}</time>
              <p><T t={n.text} /></p>
            </div>
          ))}
        </div>
      </section>
      <nav class="toc" aria-label="Sections">
        {sections.map((s, i) => (
          <a href={`#${s.id}`} data-spy={s.id} class={i === 0 ? "on" : undefined}><i></i><T t={s.label} /></a>
        ))}
      </nav>
      <Controls />
    </aside>

    <main>
      <section id="about" class="section about">
        <h2><T t={ui.about} /></h2>
        {profile.bio.map((p) => <p><T t={p} /></p>)}
      </section>

      <section id="projects" class="section">
        <h2><T t={ui.projects} /></h2>
        <div class="items">
          {projects.map((p) => (
            <a class="item" href={`/projects/${p.id}/`}>
              <Image src={p.data.cover} alt="" width={176} height={132} fit="cover" loading="lazy" />
              <div>
                <div class="t">
                  <span>{p.data.pinned && <span class="pin"><T t={ui.pinned} /></span>}<b><T t={{ en: p.data.title, ko: p.data.title_ko }} /></b></span>
                  {p.data.year && <span class="yr">{p.data.year}</span>}
                </div>
                <p><T t={{ en: p.data.summary, ko: p.data.summary_ko }} /></p>
                <div class="tags">{p.data.tags.map((t) => <span>{t}</span>)}</div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section id="research" class="section">
        <h2><T t={ui.research} /></h2>
        {paperGroups.map((g) => (
          <>
            <h3 class="sub-h"><T t={g.label} /></h3>
            {g.items.map((p) => (
              <div class="row">
                <span class="k">{p.year ?? ""}</span>
                <div>
                  <b>{p.title}</b>
                  {p.summary && <span class="m">{p.summary}</span>}
                  {p.authors && <span class="m" set:html={p.authors} />}
                  {p.venue && <span class="venue">{p.venue}</span>}
                  {p.links && (
                    <div class="pills">
                      {p.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </>
        ))}
      </section>

      <section id="experience" class="section">
        <h2><T t={ui.experience} /><a href="/pdf/Gio_Jung_Resume.pdf" target="_blank" rel="noopener"><T t={ui.downloadCv} /> ↗</a></h2>
        {experience.map((r) => (
          <div class="row">
            <span class="k">{r.years}</span>
            <div>
              <b>{r.title}</b>
              <span class="m">{r.org}</span>
              {r.summary && <span class="m">{r.summary}</span>}
              {r.points && <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>}
            </div>
          </div>
        ))}

        <h3 class="sub-h"><T t={ui.education} /></h3>
        {education.map((r) => (
          <div class="row">
            <span class="k">{r.years}</span>
            <div><b>{r.title}</b><span class="m">{r.org}</span>{r.summary && <span class="m">{r.summary}</span>}</div>
          </div>
        ))}

        <h3 class="sub-h"><T t={ui.honors} /></h3>
        {honors.map((h) => (
          <div class="row">
            <span class="k">{h.year}</span>
            <div>{h.items.map((it) => <b>{it}</b>)}</div>
          </div>
        ))}

        <h3 class="sub-h"><T t={ui.skills} /></h3>
        {skills.map((s) => (
          <div class="row">
            <span class="k"></span>
            <div><b>{s.group}</b><div class="skills">{s.items.map((it) => <span>{it}</span>)}</div></div>
          </div>
        ))}
      </section>
    </main>
  </div>

  <script>
    // Highlight the sidebar entry for the section currently in view.
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-spy]")];
    const targets = links.map((a) => document.getElementById(a.dataset.spy!)).filter(Boolean) as HTMLElement[];
    const update = () => {
      let current = targets[0]?.id;
      const line = Math.min(innerHeight * 0.35, 240);
      for (const t of targets) if (t.getBoundingClientRect().top < line) current = t.id;
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) current = targets[targets.length - 1]?.id;
      links.forEach((a) => a.classList.toggle("on", a.dataset.spy === current));
    };
    addEventListener("scroll", update, { passive: true });

    // News ticker: one item at a time, auto-advances unless the visitor is reading or prefers less motion.
    const ticker = document.querySelector<HTMLElement>(".ticker");
    if (ticker) {
      const items = [...ticker.querySelectorAll<HTMLElement>("[data-tick-item]")];
      const counter = ticker.querySelector<HTMLElement>("[data-tick-i]")!;
      let idx = 0, paused = false;
      const show = (n: number) => {
        idx = (n + items.length) % items.length;
        items.forEach((el, k) => (el.hidden = k !== idx));
        counter.textContent = String(idx + 1);
      };
      ticker.addEventListener("click", (e) => {
        const b = (e.target as Element).closest<HTMLButtonElement>("[data-tick]");
        if (b) show(idx + Number(b.dataset.tick));
      });
      ticker.addEventListener("mouseenter", () => (paused = true));
      ticker.addEventListener("mouseleave", () => (paused = false));
      ticker.addEventListener("focusin", () => (paused = true));
      ticker.addEventListener("focusout", () => (paused = false));
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        setInterval(() => { if (!paused && !document.hidden) show(idx + 1); }, 6000);
      }
    }
    addEventListener("resize", update);
    update();
  </script>
</Base>
