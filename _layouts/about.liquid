---
layout: default
---
<div class="post">
  <header class="post-header">
    <div class="hero-identity">
      {% if page.profile and page.profile.image %}
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        <div class="hero-avatar{% unless page.profile.image_circular %} hero-avatar--square{% endunless %}">
          {%
            include figure.liquid loading="eager" path=profile_image_path sizes="120px" alt=page.profile.image
            width="104" height="104" cache_bust=true
          %}
        </div>
      {% endif %}
      <div class="hero-identity__text">
        <h1 class="post-title">
          {% if site.title == 'blank' %}
            {{ site.first_name }}
            {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        {% if page.tagline %}
          <p class="hero-tagline">{{ page.tagline }}</p>
        {% endif %}
      </div>
    </div>
    <!-- Social -->
    {% if page.social %}
      <div class="social social-left">
        <div class="contact-icons">
          <a
            href="https://www.linkedin.com/in/gio-jung-1623b924b/"
            title="LinkedIn"
            target="_blank"
            rel="noopener noreferrer"
            ><i class="fa-brands fa-linkedin"></i
          ></a>
          <a
            href="https://github.com/GioJung97"
            title="GitHub"
            target="_blank"
            rel="noopener noreferrer"
            ><i class="fa-brands fa-github"></i
          ></a>
          <a
            href="https://scholar.google.com/citations?user=eGABprEAAAAJ&hl=en"
            title="Google Scholar"
            target="_blank"
            rel="noopener noreferrer"
            ><i class="ai ai-google-scholar"></i
          ></a>
          <a href="mailto:giojung6141@gmail.com" title="Email"><i class="fa-solid fa-envelope"></i></a>
        </div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </header>

  <article>
    {% if page.profile.more_info %}
      <div class="more-info">{{ page.profile.more_info }}</div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="news-heading">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit"> <span class="lang-en">News</span><span class="lang-ko">소식</span> </a>
      </h2>
      {% include news_rotator.liquid %}
    {% endif %}

    <!-- Selected Work -->
    {% assign selected_projects = site.projects | where: 'selected', true | sort: 'order' | reverse %}
    {% if selected_projects.size > 0 %}
      <section class="selected-work">
        <div class="section-heading">
          <h2><span class="lang-en">Selected Work</span><span class="lang-ko">주요 작업물</span></h2>
          <a class="section-heading__link" href="{{ '/projects/' | relative_url }}">
            <span class="lang-en">All work &rarr;</span><span class="lang-ko">전체 작업물 보기 &rarr;</span>
          </a>
        </div>
        <div class="work-grid">
          {% for project in selected_projects %}
            {% include projects.liquid %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
